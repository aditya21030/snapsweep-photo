<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_swipe_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_gold"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_swipe_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="Swipe&#10;through your&#10;photos"
        android:textColor="#12052D"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_swipe_btn_swipe"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_button_dark"
        android:gravity="center"
        android:text="Swipe"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</RelativeLayout>
